#include <iostream>
using namespace std;

char board[3][3] = {
    {'1','2','3'},
    {'4','5','6'},
    {'7','8','9'}
};

int choice;
char turn = 'X';

void display_board() {
    cout << "\n\n   TIC TAC TOE GAME\n";
    cout << "\tPlayer1 [X]\n\tPlayer2 [O]\n\n";

    cout << "\t\t  " << board[0][0] << " | " << board[0][1] << " | " << board[0][2] << "\n";
    cout << "\t\t ---|---|---\n";
    cout << "\t\t  " << board[1][0] << " | " << board[1][1] << " | " << board[1][2] << "\n";
    cout << "\t\t ---|---|---\n";
    cout << "\t\t  " << board[2][0] << " | " << board[2][1] << " | " << board[2][2] << "\n";
}

void player_turn() {
    cout << "\nPlayer " << (turn == 'X' ? "1 [X]" : "2 [O]") << " enter position: ";
    cin >> choice;

    switch(choice) {
        case 1: if(board[0][0]=='1') board[0][0]=turn; else choice=0; break;
        case 2: if(board[0][1]=='2') board[0][1]=turn; else choice=0; break;
        case 3: if(board[0][2]=='3') board[0][2]=turn; else choice=0; break;
        case 4: if(board[1][0]=='4') board[1][0]=turn; else choice=0; break;
        case 5: if(board[1][1]=='5') board[1][1]=turn; else choice=0; break;
        case 6: if(board[1][2]=='6') board[1][2]=turn; else choice=0; break;
        case 7: if(board[2][0]=='7') board[2][0]=turn; else choice=0; break;
        case 8: if(board[2][1]=='8') board[2][1]=turn; else choice=0; break;
        case 9: if(board[2][2]=='9') board[2][2]=turn; else choice=0; break;
        default: choice=0;
    }

    if(choice == 0) {
        cout << "Invalid move! Try again.\n";
        player_turn();
    }

    turn = (turn == 'X') ? 'O' : 'X';
}

bool check_win() {
    for(int i=0;i<3;i++)
        if((board[i][0]==board[i][1] && board[i][1]==board[i][2]) ||
           (board[0][i]==board[1][i] && board[1][i]==board[2][i]))
            return true;

    if((board[0][0]==board[1][1] && board[1][1]==board[2][2]) ||
       (board[0][2]==board[1][1] && board[1][1]==board[2][0]))
        return true;

    return false;
}

bool check_draw() {
    for(int i=0;i<3;i++)
        for(int j=0;j<3;j++)
            if(board[i][j] != 'X' && board[i][j] != 'O')
                return false;
    return true;
}

int main() {
    while(true) {
        display_board();
        player_turn();

        if(check_win()) {
            display_board();
            cout << "\nPlayer " << (turn == 'O' ? "1 [X]" : "2 [O]") << " WINS!\n";
            break;
        }

        if(check_draw()) {
            display_board();
            cout << "\nGAME DRAW!\n";
            break;
        }
    }
    return 0;
}
